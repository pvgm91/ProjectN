# Copie este arquivo para ".env" (na mesma pasta) e preencha.
# O arquivo .env fica so no seu PC; o .gitignore impede que ele suba.

# Shopee Afiliados -> painel affiliate.shopee.com.br -> Open API
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Amazon Creators API -> painel de Associados -> Creators API
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
# Versao mostrada ao lado da credencial (3.1 = Americas, inclui Brasil)
AMAZON_VERSION=3.1
# Seu ID de associado (store ID), ex.: projectn-20
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com.br

# GitHub: token classico com o escopo "repo", criado em github.com/settings/tokens
# Usado para enviar o codigo (repositorio privado) e o painel (pagina online).
GITHUB_TOKEN=
