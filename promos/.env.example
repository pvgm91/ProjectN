# Copie este arquivo para ".env" (na mesma pasta) e preencha.
# O arquivo .env fica so no seu PC; o .gitignore impede que ele suba.

# Shopee Afiliados -> painel affiliate.shopee.com.br -> Open API
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Amazon Creators API -> painel de Associados -> Creators API
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
# Versao mostrada ao lado da credencial (3.1 = Americas, inclui Brasil)
AMAZON_VERSION=3.1
# Seu ID de associado (store ID), ex.: projectn-20
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com.br

# Mercado Livre -> developers.mercadolivre.com.br/devcenter (aplicacao criada)
MERCADOLIVRE_APP_ID=
MERCADOLIVRE_SECRET=

# GitHub: token classico com o escopo "repo", criado em github.com/settings/tokens
# Usado para enviar o codigo (repositorio privado) e o painel (pagina online).
GITHUB_TOKEN=

# Senha do painel online (promo.projectn.com.br). Sem ela, o painel fica aberto para quem tiver o endereco.
# Use uma senha longa (frases funcionam bem). Os links curtos /l/ continuam publicos.
PAINEL_SENHA=

# Avisos no Telegram (bot seu): @BotFather -> /newbot. Depois: rodar.bat entrar avisos
TELEGRAM_BOT_TOKEN=

# Leitura de cupons com a sua conta: https://my.telegram.org -> API development tools. Depois: rodar.bat entrar telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
